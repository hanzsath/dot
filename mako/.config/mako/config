
# ============================================
# Mako — Ultra-Minimal Black & White
# ============================================

# Typography
font=JetBrainsMono Nerd Font 10
text-color=#FFFFFF

# Appearance
background-color=#000000F5
border-color=#444444
border-size=1
border-radius=0

# Size and spacing
width=320
height=100
padding=10
margin=8

# Position
anchor=top-right
layer=overlay

# Behavior
sort=-time
max-visible=4
default-timeout=4000
ignore-timeout=1

# Icons and progress
icons=1
max-icon-size=28
icon-location=left
progress-color=over #FFFFFF

# Low priority
[urgency=low]
border-color=#333333
text-color=#999999
default-timeout=3000

# Normal priority
[urgency=normal]
border-color=#555555
text-color=#FFFFFF
default-timeout=4000

# High priority
[urgency=high]
border-color=#FFFFFF
text-color=#FFFFFF
default-timeout=7000

