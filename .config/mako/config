
# Catppuccin Mocha — soft notification theme

# Typography
font=JetBrainsMono Nerd Font 10
text-color=#cdd6f4

# Soft dark surface
background-color=#1e1e2ef2
border-color=#45475a
border-size=1
border-radius=12

# Spacing and size
width=340
height=120
padding=12
margin=10

# Behavior
anchor=top-right
layer=overlay
sort=-time
max-visible=5
default-timeout=4000
ignore-timeout=1

# Icons and progress
icons=1
max-icon-size=40
icon-location=left
progress-color=over #b4befe

# Quiet, muted notifications
[urgency=low]
border-color=#585b70
text-color=#a6adc8
default-timeout=3000

# Normal notifications
[urgency=normal]
border-color=#89b4fa
text-color=#cdd6f4
default-timeout=4000

# Important notifications
[urgency=high]
border-color=#f38ba8
text-color=#f2cdcd
default-timeout=7000

